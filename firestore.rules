rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function tarefaValida(d) {
      return d.keys().hasOnly(['title', 'desc', 'status', 'criadoEm'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.desc is string && d.desc.size() <= 400
        && d.status in ['todo', 'doing', 'done'];
    }

    // Cada usuário só acessa as próprias tarefas
    match /usuarios/{uid}/tarefas/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && tarefaValida(request.resource.data);
    }
  }
}
